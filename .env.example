CRE_API_KEY=

MONAD_RPC_URL=https://testnet-rpc.monad.xyz
AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
AUSD_FAUCET=0xd236c18D274E54FAccC3dd9DDA4b27965a73ee6C
MOCK_FORWARDER=0xB9F79d863261869B234c481D1f9A7af84AeAd192
KEYSTONE_FORWARDER=0xF8344CFd5c43616a4366C34E3EEE75af79a74482

# Fiat criteria relay (must match CRE vault FIAT_RELAY_AUTH_TOKEN)
FIAT_RELAY_AUTH_TOKEN=nonapay-demo-fiat-relay

# Termii (+234 OTP). Leave unset for mock OTP (demoPin returned by API).
TERMII_API_KEY=
TERMII_SENDER_ID=NonaPay
