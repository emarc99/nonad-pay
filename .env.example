# Fresh Monad Testnet deployer only — never commit real keys
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
CRE_ETH_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
CRE_API_KEY=

MONAD_RPC_URL=https://testnet-rpc.monad.xyz
AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
AUSD_FAUCET=0xd236c18D274E54FAccC3dd9DDA4b27965a73ee6C
MOCK_FORWARDER=0xB9F79d863261869B234c481D1f9A7af84AeAd192
KEYSTONE_FORWARDER=0xF8344CFd5c43616a4366C34E3EEE75af79a74482

# CRE Vault DON secrets (also used by local `cre workflow simulate`)
# Upload with: cd workflow && cre secrets create secrets.yaml --target staging-settings --secrets-auth=browser --yes
# (values are read from these env var names — see workflow/secrets.yaml)
ENCLAVE_NULLIFIER_SALT=nonapay-enclave-salt-v1
FIAT_RELAY_AUTH_TOKEN=nonapay-fiat-relay-v1

# OTP provider: auto = africastalking → termii → mock
# OTP_PROVIDER=africastalking

# Africa's Talking Sandbox (no CAC). SMS appears in simulator, not handset:
# https://account.africastalking.com/apps/sandbox
# https://simulator.africastalking.com:1517/
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
# AFRICASTALKING_FROM=

# Termii live SMS (needs approved NG sender + DND). Prefer AT sandbox for testing.
TERMII_API_KEY=
TERMII_SENDER_ID=NonaPay
# TERMII_BASE_URL=https://api.ng.termii.com/api

# Public HTTPS URL CRE uses to fetch attestations (not localhost):
# Live: https://nonad-pay.vercel.app/api/fiat/attest
# → set workflow/remittance/config.staging.json "fiatRelayUrl" to the same value and redeploy CRE.

# Required on Vercel so OTP/attest survive across serverless instances (CRE GET).
# Vercel → Storage → Create Upstash Redis → connect → env vars auto-added:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
